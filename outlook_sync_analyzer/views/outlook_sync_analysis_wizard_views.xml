<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Wizard Form View -->
    <record id="view_outlook_sync_analysis_wizard_form" model="ir.ui.view">
        <field name="name">outlook.sync.analysis.wizard.form</field>
        <field name="model">outlook.sync.analysis.wizard</field>
        <field name="arch" type="xml">
            <form string="Analyse de synchronisation Outlook">
                <group invisible="result_html">
                    <group>
                        <field name="analysis_type" required="1"/>
                        <field name="user_ids" invisible="analysis_type not in ['user', 'user_comparison']"/>
                    </group>
                    <group>
                        <field name="days_stuck_threshold"/>
                        <field name="future_year_threshold"/>
                    </group>
                </group>

                <group invisible="not result_html">
                    <group>
                        <field name="analysis_date" readonly="1"/>
                        <field name="total_events" readonly="1"/>
                        <field name="synced_events" readonly="1"/>
                    </group>
                    <group>
                        <field name="need_sync_events" readonly="1"/>
                        <field name="stuck_events_count" readonly="1"/>
                        <field name="extreme_future_count" readonly="1"/>
                    </group>
                </group>

                <notebook invisible="not result_html">
                    <page string="Résultats" name="results">
                        <field name="result_html" nolabel="1" widget="html"/>
                    </page>
                    <page string="Markdown" name="markdown">
                        <field name="result_markdown" nolabel="1" widget="text"/>
                    </page>
                </notebook>

                <footer>
                    <button name="action_run_analysis" string="Lancer l'analyse" type="object"
                            class="btn-primary" invisible="result_html"/>
                    <button name="action_view_report" string="Voir le rapport" type="object"
                            class="btn-primary" invisible="not report_id"/>
                    <button name="action_export_report" string="Exporter" type="object"
                            invisible="not report_id"/>
                    <button string="Fermer" special="cancel" class="btn-default"/>
                </footer>
                <field name="report_id" invisible="1"/>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_outlook_sync_analysis_wizard" model="ir.actions.act_window">
        <field name="name">Analyse de synchronisation</field>
        <field name="res_model">outlook.sync.analysis.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="model_res_users"/>
        <field name="binding_view_types">form,list</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_outlook_sync_analysis"
              name="Analyse de synchronisation"
              parent="menu_microsoft_sync_analyzer_root"
              action="action_outlook_sync_analysis_wizard"
              sequence="5"/>
</odoo>
